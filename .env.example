# ===== llm-vision 环境变量模板 =====
# 复制本文件为 .env 并填入你自己的 Key（.env 已被 .gitignore 忽略，不会上传）

# 阿里云百炼 DashScope API Key（必填）
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# 视觉模型名（可选）
# 默认 qwen-vl-max（能力最强）
# 想省额度可换 qwen-vl-plus（免费额度常用款，普通识图够用）
QWEN_VL_MODEL=qwen-vl-max

# API 地址（可选，默认 OpenAI 兼容模式，一般不用改）
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
